<UserControl x:Class="BaseRobot.Views.ConnectionsUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BaseRobot.Views"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <StackPanel Orientation="Vertical">
        <Button Width="35" Height="35" Margin="15"
                Command="{Binding CommandAddConnector}">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="15"/>
                </Style>
            </Button.Resources>
            <icons:PackIconMaterial Kind="Plus"/>
        </Button>

        <ItemsControl ItemsSource="{Binding ConnectionVMs}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1"
                            Margin="5"
                            BorderBrush="AliceBlue"
                            CornerRadius="8">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding DataContext.ExchangeTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding SelectedExchangeType}"
                                      Width="150" Margin="5"/>
                                <mah:ToggleSwitch IsOn="{Binding OnConnector}" 
                                              Margin="15, 0"/>
                                <Label Content="{Binding ConnectStatus}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ParameterRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ParameterName}"
                                                       Width="100" Margin="10, 0"/>
                                            <TextBox Text="{Binding Value}"
                                                     Width="180" Margin="10, 0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
